<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="CustomActionBar"></style>

    <style name="OSS_CustomButton" parent="@style/Widget.AppCompat.Button.Borderless">
        <item name="android:background">@drawable/oss_button_selector_state</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:textSize">@dimen/subtitle_font_size</item>
        <item name="android:textColor">@color/textColorPrimary</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:paddingLeft">@dimen/module_medium</item>
        <item name="android:paddingRight">@dimen/module_medium</item>
        <item name="android:paddingTop">@dimen/module_medium</item>
        <item name="android:paddingBottom">@dimen/module_medium</item>
        <item name="android:gravity">center</item>
    </style>

    <style name="OSS_BottomSheetDialogTheme" parent="ThemeOverlay.Material3.BottomSheetDialog">
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="bottomSheetStyle">@style/OSS_BottomSheetStyle</item>
    </style>

    <style name="OSS_BottomSheetStyle" parent="Widget.Material3.BottomSheet.Modal">
        <item name="android:background">@android:color/transparent</item>
        <item name="shapeAppearanceOverlay">@style/ShapeAppearanceOverlay.MyApp.BottomSheet</item>
        <item name="backgroundTint">@android:color/white</item>
        <item name="paddingBottomSystemWindowInsets">true</item>
    </style>

    <style name="ShapeAppearanceOverlay.MyApp.BottomSheet" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSizeTopRight">16dp</item>
        <item name="cornerSizeTopLeft">16dp</item>
        <item name="cornerSizeBottomRight">0dp</item>
        <item name="cornerSizeBottomLeft">0dp</item>
    </style>

</resources>